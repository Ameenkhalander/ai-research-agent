# ---- Required -------------------------------------------------------------
# Create a key at https://console.anthropic.com/ and paste it here (never commit .env).
ANTHROPIC_API_KEY=

# ---- Optional (defaults shown) ---------------------------------------------
# Claude model used by the agent, the MCP summarise/extract tools and the evaluation judge.
CLAUDE_MODEL=claude-sonnet-5-5
MAX_TOKENS=4096

# Where SQLite + ChromaDB data live (default: ./storage inside the project).
# DATA_DIR=./storage

# Document processing / retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MAX_UPLOAD_MB=20

# Agent behaviour
MAX_PLAN_TASKS=5
MAX_TOOL_ROUNDS=4
TOOL_TIMEOUT_S=90

# Backend / frontend wiring
API_HOST=127.0.0.1
API_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# Use a remote Chroma server instead of the local persistent store (optional)
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
